DATABASE_URL=postgresql://postgres:postgres@localhost:5432/git_tracker
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000

# GitHub OAuth App (github.com/settings/developers) - used for "Sign in with GitHub"
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# GitLab OAuth App (gitlab.com/-/user_settings/applications) - used for "Sign in with GitLab"
GITLAB_CLIENT_ID=your-gitlab-oauth-client-id
GITLAB_CLIENT_SECRET=your-gitlab-oauth-client-secret
GITLAB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/gitlab/callback

# Bitbucket OAuth consumer (bitbucket.org/<workspace>/workspace/settings/oauth-consumers)
# Register the consumer's Callback URL as http://localhost:3000/api/auth/bitbucket/callback
BITBUCKET_CLIENT_ID=your-bitbucket-oauth-key
BITBUCKET_CLIENT_SECRET=your-bitbucket-oauth-secret

FRONTEND_URL=http://localhost:4200
